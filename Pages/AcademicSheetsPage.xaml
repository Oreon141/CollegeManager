<Page x:Class="CollegeManager.Pages.AcademicSheetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CollegeManager.Pages"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1200"
      Title="AcademicSheetsPage"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>

        <!-- Стиль ячеек -->
        <Style x:Key="SheetCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>

        <!-- Стиль строк -->
        <Style x:Key="SheetRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <!-- Стиль заголовков -->
        <Style x:Key="SheetHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#e0e7ff"/>
            <Setter Property="Foreground" Value="#1e293b"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Учебные ведомости"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="#1e293b"
                   Margin="0 0 0 20"/>

        <!-- Панель фильтров -->
        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="20"
                Margin="0 0 0 20">

            <WrapPanel VerticalAlignment="Center"
                       ItemWidth="280">

                <!-- Курс -->
                <StackPanel Margin="0 0 20 10">
                    <TextBlock Text="Курс"
                               FontSize="16"
                               Margin="0 0 0 5"/>

                    <ComboBox x:Name="GroupFilter"
                              Width="250"
                              Height="40"
                              FontSize="16"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              DisplayMemberPath="CourseName"/>
                </StackPanel>

                <!-- Модуль -->
                <StackPanel Margin="0 0 20 10">
                    <TextBlock Text="Модуль"
                               FontSize="16"
                               Margin="0 0 0 5"/>

                    <ComboBox x:Name="SubjectFilter"
                              Width="250"
                              Height="40"
                              FontSize="16"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              DisplayMemberPath="ModuleName"/>
                </StackPanel>

                <!-- Семестр -->
                <StackPanel Margin="0 0 20 10">
                    <TextBlock Text="Семестр"
                               FontSize="16"
                               Margin="0 0 0 5"/>

                    <ComboBox x:Name="SemesterFilter"
                              Width="180"
                              Height="40"
                              FontSize="16"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"/>
                </StackPanel>

                <!-- Кнопка -->
                <Button Content="Сформировать"
                        Width="180"
                        Height="42"
                        Margin="10 22 0 0"
                        Style="{StaticResource PrimaryButton}"
                        Click="GenerateSheet_Click"/>
            </WrapPanel>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="15">

            <DataGrid x:Name="AcademicGrid"
                      AutoGenerateColumns="True"
                      FontSize="15"
                      Background="Transparent"
                      AlternatingRowBackground="#eef3ff"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      ColumnWidth="*"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      AutoGeneratingColumn="AcademicGrid_AutoGeneratingColumn"
                      CellStyle="{StaticResource SheetCellStyle}"
                      RowStyle="{StaticResource SheetRowStyle}"
                      ColumnHeaderStyle="{StaticResource SheetHeaderStyle}">

                <DataGrid.Resources>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    </Style>
                </DataGrid.Resources>

            </DataGrid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 15 0 0">

            <Button Content="Экспорт DOCX"
                    Width="180"
                    Height="40"
                    Margin="0 0 10 0"
                    Style="{StaticResource SecondaryButton}"
                    Click="ExportDocx_Click"/>

            <Button Content="Экспорт Excel"
                    Width="180"
                    Height="40"
                    Style="{StaticResource SuccessButton}"
                    Click="ExportExcel_Click"/>

        </StackPanel>

    </Grid>
</Page>