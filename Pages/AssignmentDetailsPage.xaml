<Page x:Class="CollegeManager.Pages.AssignmentDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      mc:Ignorable="d" 
      Background="{StaticResource BackgroundBrush}"
      Title="Информация о задании">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 25">
                <Button Content="← Назад"
                        Height="48"
                        Padding="30 0"
                        Background="#2563eb"
                        Foreground="White"
                        FontSize="20"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>

                <TextBlock Text="Информация о задании"
                           Margin="25 0"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1e293b"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="35">
                <StackPanel>
                    <TextBlock Text="Название" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="TitleText" FontSize="20" Margin="0 10 0 25" TextWrapping="Wrap" Foreground="#1e293b"/>

                    <TextBlock Text="Описание" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="DescriptionText" FontSize="20" Margin="0 10 0 25" TextWrapping="Wrap" Foreground="#1e293b"/>

                    <TextBlock Text="Модуль / Курс" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="ModuleText" FontSize="20" Margin="0 10 0 25" Foreground="#1e293b"/>

                    <TextBlock Text="Статус" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="StatusText" FontSize="20" Margin="0 10 0 25" Foreground="#1e293b"/>

                    <TextBlock Text="Студент (Исполнитель)" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="UserText" FontSize="20" Margin="0 10 0 25" Foreground="#1e293b"/>

                    <Button Content="✎ Редактировать задание"
                            x:Name="EditButton"
                            Height="48"
                            Width="260"
                            Margin="0 20 0 0"
                            Background="#4f46e5"
                            Foreground="White"
                            FontSize="18"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Edit_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>