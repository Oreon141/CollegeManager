<Page x:Class="CollegeManager.Pages.AssignmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="AssignmentsPage"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <Style x:Key="StatusColorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="не начат">
                    <Setter Property="Foreground" Value="#f87171"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="в процессе">
                    <Setter Property="Foreground" Value="#60a5fa"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="выполнен">
                    <Setter Property="Foreground" Value="#34d399"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 25">
                <TextBlock x:Name="TitleBlock"
                           Text="Задания"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1e293b"
                           VerticalAlignment="Center"/>

                <Button Content="← Назад"
                        Height="48"
                        Padding="30 0"
                        Margin="25 0 0 0"
                        Background="#475569"
                        Foreground="White"
                        FontSize="20"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>

                <Button Content="+ Новое задание"
                        x:Name="CreateAssignmentBtn"
                        Height="48"
                        Padding="28 0"
                        Margin="25 0 0 0"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        FontSize="20"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CreateAssignment_Click"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
                        <StackPanel Margin="0 0 25 0">
                            <TextBlock Text="Поиск" FontSize="20" Foreground="#475569"/>
                            <TextBox x:Name="SearchBox" Width="250" Height="42" FontSize="18" Padding="10" 
                                     Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" 
                                     TextChanged="Filter_Changed"/>
                        </StackPanel>

                        <StackPanel Margin="0 0 25 0">
                            <TextBlock Text="Статус" FontSize="20" Foreground="#475569"/>
                            <ComboBox x:Name="StatusFilter" Width="200" Height="42" FontSize="18" 
                                      Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" 
                                      DisplayMemberPath="StatusName" SelectionChanged="Filter_Changed"/>
                        </StackPanel>

                        <Button Content="Сбросить" Height="42" Padding="20 0" Margin="0 25 0 0" 
                                Background="#64748b" Foreground="White" FontSize="18" BorderThickness="0" 
                                Click="ResetFilters_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="AssignmentsGrid" Grid.Row="1" AutoGenerateColumns="False" 
                              IsReadOnly="True" FontSize="18" RowHeight="42" Background="Transparent" 
                              BorderThickness="0" AlternatingRowBackground="#eef3ff" Cursor="Hand" 
                              GridLinesVisibility="None" Margin="0 15 0 0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding AssignmentName}" Width="2*"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding AssignmentDescription}" Width="3*"/>
                            <DataGridTemplateColumn Header="Статус" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Statuses.StatusName}" Style="{StaticResource StatusColorStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Открыть" Width="70" Height="34" Background="#2563eb" Foreground="White" BorderThickness="0" Margin="0 0 6 0" Tag="{Binding AssignmentID}" Click="OpenAssignment_Click"/>
                                            <Button Content="✎" Width="38" Height="34" Background="#475569" Foreground="White" BorderThickness="0" Margin="0 0 6 0" Tag="{Binding AssignmentID}" Click="EditAssignment_Click"/>
                                            <Button Content="🗑" Width="38" Height="34" Background="#dc2626" Foreground="White" BorderThickness="0" Tag="{Binding AssignmentID}" Click="DeleteAssignment_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>