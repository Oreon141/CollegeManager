<Page x:Class="CollegeManager.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="ChatPage"
      Background="#f1f5f9">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#dbe4f0"
                BorderThickness="0 0 1 0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->

                <DockPanel Margin="20">

                    <TextBlock Text="Чаты"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </DockPanel>

                <!-- ПОИСК -->

                <TextBox x:Name="SearchBox"
                         Grid.Row="1"
                         Margin="15 0"
                         Height="42"
                         FontSize="14"
                         Padding="12"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>

                <!-- ЗАГОЛОВОК -->

                <TextBlock Grid.Row="2"
                           Text="Личные сообщения"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="15 10"/>

                <!-- СПИСОК -->

                <ListBox x:Name="ChatsList"
                         Grid.Row="3"
                         Margin="10"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="ChatsList_SelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Background="White"
                                    CornerRadius="14"
                                    Padding="12"
                                    Margin="0 0 0 10"
                                    BorderBrush="#e2e8f0"
                                    BorderThickness="1"
                                    Width="340"
                                    Height="82">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- АВАТАР -->

                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="23"
                                            Background="#2563eb"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   Width="20"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <!-- ТЕКСТ -->

                                    <StackPanel Grid.Column="1"
                                                Margin="12 0 0 0"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding TypeText}"
                                                   Foreground="Gray"
                                                   FontSize="12"
                                                   Margin="0 5 0 0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

        <!-- ПРАВАЯ ЧАСТЬ -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Border Background="White"
                    BorderBrush="#dbe4f0"
                    BorderThickness="0 0 0 1">

                <DockPanel>

                    <TextBlock x:Name="SelectedChatText"
                               Text="Выберите чат"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="20"
                               VerticalAlignment="Center"/>

                    <Button x:Name="DeleteChatButton"
                            Content="Удалить чат"
                            Width="130"
                            Height="36"
                            Margin="0 0 20 0"
                            DockPanel.Dock="Right"
                            Background="#dc2626"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="DeleteChat_Click"/>

                </DockPanel>

            </Border>

            <!-- СООБЩЕНИЯ -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <ListBox x:Name="MessagesList"
                         Margin="15"
                         BorderThickness="0"
                         Background="Transparent">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Background="White"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0 0 0 10"
                                    MaxWidth="500">

                                <StackPanel>

                                    <TextBlock Text="{Binding Users.Login}"
                                               FontWeight="Bold"
                                               Foreground="#2563eb"/>

                                    <TextBlock Text="{Binding MessageText}"
                                               Margin="0 6 0 0"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding SentAt}"
                                               HorizontalAlignment="Right"
                                               Foreground="Gray"
                                               FontSize="11"
                                               Margin="0 6 0 0"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </ScrollViewer>

            <!-- ВВОД -->

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#dbe4f0"
                    BorderThickness="1 0 0 0"
                    Padding="15">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageTextBox"
                             Height="45"
                             FontSize="14"
                             Padding="12"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Отправить"
                            Margin="12 0 0 0"
                            Background="#2563eb"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="SendMessage_Click"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>
</Page>