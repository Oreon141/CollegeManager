<Page x:Class="CollegeManager.Pages.CourseDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CollegeManager.Pages"
      mc:Ignorable="d" 
      Background="{StaticResource BackgroundBrush}"
      Title="Детали курса">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 25">
                <TextBlock x:Name="CourseTitle"
                           Text="Курс"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#1e293b"/>

                <Button Content="← Назад"
                        Height="48"
                        Margin="25 0 0 0"
                        Padding="25 0"
                        FontSize="20"
                        Background="#475569"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="35">
                <StackPanel>
                    <TextBlock Text="Наименование дисциплины" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="NameText" FontSize="20" Margin="0 8 0 22" Foreground="#1e293b"/>

                    <TextBlock Text="Описание" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="DescriptionText" FontSize="20" TextWrapping="Wrap" Margin="0 8 0 22" Foreground="#1e293b"/>

                    <Grid Margin="0 10 0 20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Форма контроля" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock x:Name="ControlFormText" FontSize="20" Margin="0 8 0 22" Foreground="#1e293b"/>

                            <TextBlock Text="Статус" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock x:Name="StatusText" FontSize="20" Margin="0 8 0 22" Foreground="#1e293b"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дата начала" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock x:Name="StartDateText" FontSize="20" Margin="0 8 0 22" Foreground="#1e293b"/>

                            <TextBlock Text="Дедлайн" FontSize="22" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock x:Name="DeadlineText" FontSize="20" Margin="0 8 0 22" Foreground="#1e293b"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                        <Button Content="✎ Редактировать" Height="48" Width="200" Margin="0 0 20 0" 
                                Background="#2563eb" Foreground="White" FontSize="18" FontWeight="SemiBold" 
                                BorderThickness="0" Cursor="Hand" Click="Edit_Click"/>

                        <Button Content="📚 Модули" Height="48" Width="180" Margin="0 0 20 0" 
                                Background="#475569" Foreground="White" FontSize="18" FontWeight="SemiBold" 
                                BorderThickness="0" Cursor="Hand" Click="OpenModules_Click"/>

                        <Button Content="📝 Задания" Height="48" Width="180" Margin="0 0 20 0" 
                                Background="#64748b" Foreground="White" FontSize="18" FontWeight="SemiBold" 
                                BorderThickness="0" Cursor="Hand" Click="OpenAssignments_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>