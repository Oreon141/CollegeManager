<Page x:Class="CollegeManager.Pages.CourseModulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CollegeManager.Pages"
      mc:Ignorable="d" 
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded"
      Title="Модули курса">

    <Page.Resources>
        <Style x:Key="StatusColorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="не начат">
                    <Setter Property="Foreground" Value="#f87171"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="в процессе">
                    <Setter Property="Foreground" Value="#60a5fa"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="выполнен">
                    <Setter Property="Foreground" Value="#34d399"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="← Назад" Width="120" Height="40" FontSize="16" 
                Background="#475569" Foreground="White" Margin="0 0 0 10" 
                HorizontalAlignment="Left" Click="BackButton_Click"/>

        <TextBlock Grid.Row="1" Text="Модули курса" FontSize="32" FontWeight="Bold" 
                   Foreground="#1e293b" Margin="0 0 0 20"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Поиск" FontSize="16"/>
                        <TextBox x:Name="SearchBox" Width="240" Height="40" FontSize="16" 
                                 Padding="8" TextChanged="FilterChanged" Background="#f1f5f9" BorderBrush="#cbd5e1"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Статус" FontSize="16"/>
                        <ComboBox x:Name="StatusViewFilter" VerticalContentAlignment="Center" Cursor="Hand" 
                                  Width="200" Height="40" FontSize="16" SelectionChanged="FilterChanged" 
                                  Background="#f1f5f9" BorderBrush="#cbd5e1"/>
                    </StackPanel>

                    <Button Content="Сбросить" Width="120" Height="40" FontSize="16" Cursor="Hand" 
                            Margin="20 24 0 0" Background="#475569" Foreground="White" Click="ResetFilters_Click"/>

                    <Button Content="+ Создать" x:Name="CreateModuleBtn" Width="120" Height="40" 
                            Cursor="Hand" FontSize="16" Margin="20 24 0 0" Background="#3b82f6" 
                            Foreground="White" Click="AddModule_Click"/>
                </StackPanel>

                <DataGrid x:Name="ModulesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          FontSize="16" Background="Transparent" BorderThickness="0" GridLinesVisibility="None" 
                          AlternatingRowBackground="#eef3ff" MouseDoubleClick="ModulesGrid_MouseDoubleClick" 
                          Margin="0 10 0 0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding ModuleNumber}" Width="60"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding ModuleName}" Width="2*"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding ModuleDescription}" Width="3*"/>
                        <DataGridTemplateColumn Header="Статус" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Statuses.StatusName}" Style="{StaticResource StatusColorStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Действия" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Открыть" Width="70" Height="30" Margin="0 0 8 0" Background="#2563eb" 
                                                Foreground="White" Tag="{Binding ModuleID}" Click="OpenModule_Click"/>
                                        <Button Content="🗑" Width="50" Height="30" Background="#dc2626" 
                                                Foreground="White" Tag="{Binding ModuleID}" Click="DeleteModule_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>