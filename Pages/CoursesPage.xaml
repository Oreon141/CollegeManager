<Page x:Class="CollegeManager.Pages.CoursesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CollegeManager.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1050"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded"
      Title="Курсы и дисциплины">

    <Page.Resources>
        <Style x:Key="StatusColorStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="Выдано / Запланировано">
                    <Setter Property="Foreground" Value="#f87171"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="В процессе выполнения">
                    <Setter Property="Foreground" Value="#60a5fa"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statuses.StatusName}" Value="Принято / Завершено">
                    <Setter Property="Foreground" Value="#34d399"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 20">
            <TextBlock Text="Курсы и дисциплины"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1e293b"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 0 10">
            <Button Content="Создать курс"
                    x:Name="CreateCourseButton"
                    Width="180" Height="40" Cursor="Hand" FontSize="16"
                    Background="#3b82f6" Foreground="White" Margin="0 0 10 0"
                    Click="CreateCourse_Click"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Margin="0 0 0 15">
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Поиск" FontSize="16" Margin="0 0 0 4"/>
                        <TextBox x:Name="SearchBox" Width="220" Height="40" FontSize="16" Padding="8"
                                 Background="#f1f5f9" BorderBrush="#cbd5e1"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Статус" FontSize="16" Margin="0 0 0 4"/>
                        <ComboBox x:Name="StatusFilter" VerticalContentAlignment="Center" Cursor="Hand"
                                  Width="200" Height="40" FontSize="16" Background="#f1f5f9" BorderBrush="#cbd5e1"
                                  SelectionChanged="FilterChanged" DisplayMemberPath="StatusName" SelectedValuePath="StatusID"/>
                    </StackPanel>

                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Форма контроля" FontSize="16" Margin="0 0 0 4"/>
                        <ComboBox x:Name="ControlFormFilter" VerticalContentAlignment="Center" Cursor="Hand"
                                  Width="200" Height="40" FontSize="16" Background="#f1f5f9" BorderBrush="#cbd5e1"
                                  SelectionChanged="FilterChanged"/>
                    </StackPanel>

                    <Button Content="Сбросить" Width="120" Height="40" Cursor="Hand" FontSize="16"
                            Background="#475569" Foreground="White" Margin="10 24 0 0"
                            Click="ResetFilters_Click"/>
                </WrapPanel>

                <DataGrid x:Name="CoursesGrid"
                          Grid.Row="1" AutoGenerateColumns="False" Cursor="Hand" IsReadOnly="True" FontSize="16"
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                          AlternatingRowBackground="#eef3ff" ColumnHeaderHeight="45" Margin="0 10 0 0"
                          LoadingRow="CoursesGrid_LoadingRow" AutoGeneratingColumn="CoursesGrid_AutoGeneratingColumn"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="CoursesGrid_MouseDoubleClick">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="45"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Background" Value="#f1f5f9"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding CourseName}" Width="2.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Дедлайн" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Контроль" Binding="{Binding ControlForm}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Статус" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Statuses.StatusName}"
                                               Style="{StaticResource StatusColorStyle}"
                                               FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Действия" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Открыть" Width="70" Height="30" Margin="0 0 8 0"
                                                Background="#2563eb" Foreground="White"
                                                Tag="{Binding CourseID}" Click="OpenCourse_Click"/>

                                        <Button Content="🗑" Width="50" Height="30"
                                                Background="#dc2626" Foreground="White"
                                                Tag="{Binding CourseID}" Click="DeleteCourse_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>