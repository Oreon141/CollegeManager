<Page x:Class="CollegeManager.Pages.CreateAssignmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded"
      Title="CreateAssignmentPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Text="Создание задания"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#1e293b"/>

                <Button Content="← Назад"
                        Width="140"
                        Height="45"
                        Margin="20 0 0 0"
                        FontSize="16"
                        Background="#475569"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Back_Click"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="30"
                    Margin="0 20 0 0"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch">

                    <TextBlock Text="Название задания" FontSize="18"/>
                    <TextBox x:Name="AssignmentNameBox"
                             Height="45"
                             Margin="0 5 0 25"
                             Padding="10"
                             FontSize="16"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"/>

                    <TextBlock Text="Описание" FontSize="18"/>
                    <TextBox x:Name="DescriptionBox"
                             Height="140"
                             Padding="10"
                             Margin="0 5 0 25"
                             FontSize="16"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"/>

                    <TextBlock Text="Статус" FontSize="18"/>
                    <ComboBox x:Name="StatusBox"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Height="50"
                              Margin="0 5 0 25"
                              FontSize="16"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"/>

                    <TextBlock Text="Исполнитель" FontSize="18"/>
                    <ComboBox x:Name="UserBox"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Height="50"
                              Margin="0 5 0 35"
                              FontSize="16"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"/>

                    <Button Content="Создать задание"
                            Height="55"
                            Width="260"
                            FontSize="18"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Create_Click"
                            Cursor="Hand"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>