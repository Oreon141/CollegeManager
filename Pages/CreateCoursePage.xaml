<Page x:Class="CollegeManager.Pages.CreateCoursePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
      mc:Ignorable="d" 
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded"
      Title="Создание курса">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Stretch">
                <TextBlock Text="Создание курса"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#1e293b"
                           VerticalAlignment="Center"/>

                <Button Content="← Назад"
                        HorizontalAlignment="Right"
                        Margin="20 0 0 0"
                        Width="140"
                        Height="45"
                        Background="#475569"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="16"
                        Click="Back_Click"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="30"
                    Margin="0 20 0 0"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch">

                    <TextBlock Text="Название курса" FontSize="18"/>
                    <TextBox x:Name="CourseNameBox"
                             Height="45"
                             Margin="0 5 0 25"
                             FontSize="16"
                             Padding="10"
                             HorizontalAlignment="Stretch"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"/>

                    <TextBlock Text="Описание" FontSize="18"/>
                    <TextBox x:Name="DescriptionBox"
                             Height="140"
                             Margin="0 5 0 25"
                             FontSize="16"
                             Padding="10"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Stretch"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"/>

                    <Grid Margin="0 5 0 25"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Дата начала" FontSize="18"/>
                            <DatePicker x:Name="StartDatePicker"
                                        Height="45"
                                        FontSize="16"
                                        Padding="6"
                                        Background="#f1f5f9"
                                        BorderBrush="#cbd5e1"
                                        HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дедлайн" FontSize="18"/>
                            <DatePicker x:Name="DeadlinePicker"
                                        Height="45"
                                        FontSize="16"
                                        Padding="6"
                                        Background="#f1f5f9"
                                        BorderBrush="#cbd5e1"
                                        HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Форма контроля" FontSize="18"/>
                    <TextBox x:Name="ControlFormBox"
                             Height="45"
                             Margin="0 5 0 25"
                             FontSize="16"
                             Padding="10"
                             HorizontalAlignment="Stretch"
                             Background="#f1f5f9"
                             BorderBrush="#cbd5e1"/>

                    <TextBlock Text="Статус" FontSize="18"/>
                    <ComboBox x:Name="StatusBox"
                              VerticalContentAlignment="Center"
                              Cursor="Hand"
                              Height="45"
                              Margin="0 5 0 35"
                              FontSize="16"
                              Background="#f1f5f9"
                              BorderBrush="#cbd5e1"
                              HorizontalAlignment="Stretch"/>

                    <Button Content="Создать курс"
                            Height="55"
                            Width="260"
                            FontSize="18"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Create_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>